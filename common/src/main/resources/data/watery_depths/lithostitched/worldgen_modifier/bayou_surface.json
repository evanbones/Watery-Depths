{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": [
        "watery_depths:bayou"
      ]
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:water",
        "offset": -1,
        "surface_depth_multiplier": 0,
        "add_stone_depth": false
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": {
          "Name": "minecraft:mud"
        }
      }
    }
  }
}