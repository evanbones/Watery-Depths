{
  "multipart": [
    {
      "when": { "part": "middle" },
      "apply": { "model": "watery_depths:block/tubeworm_middle" }
    },
    {
      "when": { "part": "top", "sheared": "true" },
      "apply": { "model": "watery_depths:block/dead_tubeworm" }
    },
    {
      "when": { "part": "top", "sheared": "false", "hiding": "true" },
      "apply": { "model": "watery_depths:block/tubeworm_hiding" }
    },
    {
      "when": { "part": "top", "sheared": "false", "hiding": "false" },
      "apply": { "model": "watery_depths:block/tubeworm" }
    }
  ]
}